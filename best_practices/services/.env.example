# Sao chép thành .env rồi sửa:  cp .env.example .env
# Biến môi trường thật (export ...) luôn ưu tiên hơn giá trị trong file này.

# Chuỗi 3 node: địa chỉ MaxScale của từng node, thử lần lượt từ trái sang phải (failover theo chuỗi)
DB_HOSTS=172.24.220.161,172.24.220.244,172.24.220.65
# Cổng dịch vụ đọc/ghi của MaxScale (readwritesplit). Mỗi host có thể ghi riêng dạng host:port
DB_PORT=4006

DB_USER=tdht
DB_PASSWORD=CHANGE_ME
DB_NAME=vn_provinces

# Tùy chọn
# DB_CONNECT_TIMEOUT=3      giây chờ nối mỗi node
# DB_READ_TIMEOUT=20        giây chờ một truy vấn
# DB_MAX_ATTEMPTS=5         số lần thử lại khi gặp lỗi tạm thời
# DB_POOL_SIZE=4            số kết nối tối đa mỗi service
# LOG_LEVEL=INFO
