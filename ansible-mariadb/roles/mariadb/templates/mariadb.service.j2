[Unit]
Description=MariaDB (port={{ inst.port }})
Documentation=man:mariadbd(8)
After=network.target

[Service]
User={{ inst.user }}
Group={{ inst.user }}
SupplementaryGroups={{ mariadb_log_group }}
UMask=0027

{% if mariadb_jemalloc_path | length > 0 %}
Environment="LD_PRELOAD={{ mariadb_jemalloc_path }}"
{% endif %}

{% if mariadb_galera_enabled %}
# /run/<service> do systemd tạo (tmpfs, chỉ user instance vào được), thay cho /tmp
RuntimeDirectory={{ inst.service }}
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
EnvironmentFile=-{{ inst.run_dir }}/wsrep-new-cluster
EnvironmentFile=-{{ inst.run_dir }}/wsrep-start-position

ExecStartPre=/bin/sh -c "[ ! -e {{ inst.install_dir }}/bin/galera_recovery ] && VAR= || \
 VAR=`{{ inst.install_dir }}/bin/galera_recovery`; [ $? -eq 0 ] \
 && echo _WSREP_START_POSITION=$VAR > {{ inst.run_dir }}/wsrep-start-position || exit 1"
{% endif %}

ExecStart=/usr/bin/numactl --interleave=all {{ inst.install_dir }}/bin/mariadbd \
 $MYSQLD_OPTS \
 --defaults-file={{ inst.conf_file }} \
 --basedir={{ inst.install_dir }}{{ ' $_WSREP_NEW_CLUSTER $_WSREP_START_POSITION' if mariadb_galera_enabled else '' }}

TimeoutStartSec=9000
TimeoutStopSec=9000
Restart=on-failure
RestartSec=5
LimitNOFILE={{ mariadb_max_open_files }}

[Install]
WantedBy=multi-user.target
