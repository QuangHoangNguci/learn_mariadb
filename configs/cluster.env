# MariaDB multi-instance configuration.
# Mo ta chi tiet va vi du: README.md; xem truoc: bash scripts/show_config.sh

# CORE / TOPOLOGY
TOPOLOGY="single"                       # single | dr | cluster | dr-cluster
INSTALL_MODE="fresh"                    # fresh | expand
DR_NODE_IP=""                           # rong = auto-detect
PRIMARY_NODES=""                        # bat buoc voi dr / dr-cluster

# INSTANCES: tu dong nhan ID tu ten INSTANCE_<ID>, khong can khai bao danh sach ID.
# PORT MGNT SIZE_GB BUF_MB MAX_RW MAX_RO CLUSTER_NAME GALERA_PASS MAXSCALE_PASS
INSTANCE_1=(3306 1301 1700 auto 4006 4016 "money" '' '')
INSTANCE_2=(3307 1302 70   2048 4007 4017 "report" '' '')
INSTANCE_6=(3308 1306 700  auto 4008 4018 "risk" '' '')
INSTANCE_9=(3309 1309 1800 auto 4009 4019 "audit" '' '')

# PATHS / NAMING
DATA_DIR_PATTERN="/u01/data_{ID}/database"
TMP_DIR_PATTERN="/u01/data_{ID}/database_tmp"
LOG_DIR_PATTERN="/u01/logs_{ID}/mariadb"
BINLOG_DIR_PATTERN="/u01/logs_{ID}/mariadb/binlog"
INSTALL_BASE_DIR="/usr/local"
INSTANCE_NAME_PREFIX="mariadb"
CONFIG_FILE_PATTERN="/etc/my_{ID}.cnf"

# GALERA
CLUSTER_NODES=""
NODE_ROLE="bootstrap"                   # bootstrap | joiner
NODE_NAME_PREFIX="db"
WSREP_BASE_PORT=1030
WSREP_PORT_STEP=100
GALERA_USER_PREFIX="galera"
SERVER_ID_BASE=1
GTID_DOMAIN_BASE=100

# MAXSCALE
ENABLE_MAXSCALE=true
MAXSCALE_USER="maxscale"
MAXSCALE_REST_BASE_PORT=1800
MAXSCALE_PACKAGE_TYPE="auto"            # auto | deb | tar

# DATABASE INIT / TUNING
ADMIN_PASS=''
COMMON_PASS=''
EMPTY_CLUSTER=false
RESERVED_RAM_PCT=25
DISK_TYPE="auto"                        # auto | ssd | hdd
EXPIRE_LOGS_DAYS=3

# BACKUP / DB JOBS
DB_SCRIPT_DIR="/u01/apps/db_script"
DB_JOB_OS_USER="mariadb_jobs"
VECTOR_OS_USER="vector_mariadb"
VECTOR_OS_GROUP="vector_mariadb"
MARIADB_LOG_GROUP="mariadb_log_readers"
BACKUP_DIR="/backup/backup_mariadb"
BACKUP_RETENTION_DAYS=3
BACKUP_DB_USER="mbackup"
BACKUP_DB_PASS=""                       # rong = COMMON_PASS
MINIO_MC_BIN="/usr/local/bin/mc"
MINIO_ALIAS="backup"
MINIO_CHECKSUM_BUCKET="checksum"
MINIO_BUCKET_PREFIX="db-"
BACKUP_ENC_PASS=""

# HOST / NETWORK
ENABLE_NUMA_DISABLE=true
ENABLE_THP_DISABLE=true
MAX_OPEN_FILES=1000000
SYSLOG_IP="127.0.0.1"
NTP_IP="127.0.0.1"
DNS_IP="8.8.8.8"
MGMT_NODES=""
